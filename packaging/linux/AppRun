#!/bin/sh
# 保留调用目录，使显式配置和默认 ling.toml 解析一致。
# Preserve the caller's directory for explicit configuration and ling.toml.
set -eu
app_dir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
if [ "${1:-}" = "--cli" ]; then
    shift
    exec "$app_dir/usr/bin/ling-cli" "$@"
fi
exec "$app_dir/usr/bin/ling" "$@"
